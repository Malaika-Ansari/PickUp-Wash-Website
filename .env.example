# ==============================================================================
# PICKUP WASH - SUPABASE BACKEND CONFIGURATION
# Location: Kasur City, Pakistan
# ==============================================================================
# Instructions:
# 1. Create a project at https://supabase.com
# 2. Run the database schema in supabase/schema.sql in the Supabase SQL Editor.
# 3. Go to Project Settings -> API in your Supabase dashboard.
# 4. Copy your Project URL and Anon (Publishable) Public Key below.
# 5. Duplicate this file as '.env' (never commit your live .env to Git).
#
# IMPORTANT SECURITY NOTICE:
# - Use ONLY the public Anon/Publishable key here (VITE_SUPABASE_ANON_KEY).
# - NEVER put the service_role secret key or PostgreSQL database password in frontend code.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# FUTURE EXTERNAL NOTIFICATIONS INTEGRATION (OPTIONAL / WHEN READY TO ACTIVATE)
# In-app notifications are already live and functional via Supabase & local cache.
# The following services are prepared in src/services/notificationChannels.ts.
# Do NOT activate paid external services until your accounts/gateways are approved.
#
# IMPORTANT SECURITY ARCHITECTURE DIRECTIVE:
# Master API keys for Resend, Meta WhatsApp, and SMS gateways must be deployed
# to server-side Supabase Secrets / Edge Functions, NEVER bundled into frontend JavaScript!
# ==============================================================================

# 1. Email Notifications (e.g. Resend or Supabase Custom SMTP)
# VITE_RESEND_API_KEY=re_your_resend_api_key
# VITE_EMAIL_SENDER="Pickup Wash Kasur <notifications@pickupwash.pk>"

# 2. WhatsApp Business Notifications (Meta WhatsApp Cloud API)
# VITE_WHATSAPP_ACCESS_TOKEN=EAAG...
# VITE_WHATSAPP_PHONE_NUMBER_ID=100123456789012
# VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=200123456789012

# 3. Pakistan Branded SMS Gateway (TeleStax, Zong Business, Jazz Business, SMS Alert PK)
# VITE_SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
# VITE_PAKISTAN_SMS_SECRET=your_sms_gateway_secret
# VITE_SMS_MASK=PICKUPWASH
